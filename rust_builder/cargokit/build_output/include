/**
 * EPUB 分页：每页最小行数
 * 防止每页行数过少导致显示异常
 * EPUB 分页：每页最小字符数
 * 防止分页过小导致性能问题
 */
#define EPUB_MIN_CHARS_PER_PAGE 500

/**
 * 默认每章包含的页数
 */
#define DEFAULT_PAGES_PER_CHAPTER 10

#define SEARCH_CHUNK_SIZE 500

/**
 * 当前排版缓存版本号
 *
 * 每次破坏性变更时递增，旧版本数据在读取时静默丢弃。
 */
#define LAYOUT_CACHE_VERSION 2

/**
 * PDF 文本估算：每页默认字符数
 * 用于在无法精确计算时估算 PDF 文本内容量
 */
#define PDF_CHARS_PER_PAGE 500

/**
 * 排版：最小行宽（字符数）
 * 防止行宽过小导致文本过度换行
 */
#define MIN_CHARS_PER_LINE 10

